# Copy to .env on the SERVER; never commit actual secrets.
DOMAIN=callguard.mktech.net.tr
PUBLIC_ORIGIN=https://callguard.mktech.net.tr
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATA_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
ACCOUNT_ID_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_WEB_OAUTH_CLIENT_ID
SMTP_URL=smtps://USER:PASSWORD@SMTP_HOST:465
MAIL_FROM=CallGuard <REPLACE_WITH_YOUR_VERIFIED_EMAIL>
ANDROID_PACKAGE=com.callguard.mobile
PLAY_PRODUCT_ID=callguard_pro_lifetime
PORT=8080
